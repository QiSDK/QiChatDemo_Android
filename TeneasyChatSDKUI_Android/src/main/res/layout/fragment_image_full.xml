<?xml version="1.0" encoding="utf-8"?>
<!-- D3：根布局换成 DragDismissFrameLayout，支持下拉关闭（对齐 Flutter FullImageView 手势） -->
<com.teneasy.chatuisdk.ui.base.DragDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drag_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chatBody"
    tools:context=".VideoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llTop"
            android:layout_width="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="47dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="47dp"
                android:layout_height="47dp"
                android:src="@drawable/backicon"
                ></ImageView>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="连接客服中..."
                android:layout_weight="1"
                android:textSize="18sp"
                android:layout_marginEnd="23dp"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:gravity="center"></TextView>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <ScrollView
            android:id="@+id/scroll_container"
            app:layout_constraintTop_toBottomOf="@id/llTop"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <!-- Container to ensure scroll view has a single direct child -->
            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/ivImage"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:maxHeight="80200dp"
                android:src="@drawable/sample"
                android:adjustViewBounds = "true"
                android:layout_margin="10dp"
                android:layout_height="wrap_content"
                android:scaleType="centerInside" />

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.teneasy.chatuisdk.ui.base.DragDismissFrameLayout>
